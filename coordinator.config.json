{
  "branch": "crepe-editor",
  "setup": [
    ["bun", "install", "--frozen-lockfile"]
  ],
  "verification": {
    "quick": [
      ["git", "diff", "--check"],
      ["bun", "run", "build"],
      ["bun", "test"]
    ],
    "full": [["bun", "run", "test:e2e"]],
    "browserCommand": ["bunx", "playwright", "test", "--workers=1", "--retries=0"],
    "affected": [
      { "match": "^(docs/|\\.agents/|AGENTS\\.md$|CONTEXT\\.md$|scripts/coordinat|coordinator\\.config\\.json$)", "commands": [] },
      { "match": "^src/.*\\.test\\.ts$", "commands": [] },
      { "match": "^src/(historical-draft\\.ts|version-history\\.tsx)$", "commands": [["bunx", "playwright", "test", "scripts/historical-reconciliation.e2e.ts", "scripts/export-dialog.e2e.ts", "--workers=1", "--retries=0"]] },
      { "match": "^src/(workspace-drag|use-workspace-drag)\\.tsx?$", "commands": [["bunx", "playwright", "test", "scripts/question-bank-drag.e2e.ts", "--workers=1", "--retries=0"]] },
      { "match": "^src/workspace-split\\.tsx$", "commands": [["bunx", "playwright", "test", "scripts/workspace-layout.e2e.ts", "--workers=1", "--retries=0"]] },
      { "match": "^src/(App\\.tsx|styles\\.css|exam-store\\.ts|exam-page\\.tsx|indexeddb-authoring\\.ts|storage-schema\\.ts)$", "full": true }
    ],
    "required": [
      { "match": "^(src/(export-(plan|preparation|fixtures|media)|docx-export|pdf-export|dom-measure|page-item-view|doc-view|exam-page|styles)|scripts/(test-exports|export-parity|pdf-manifest)|playwright\\.exports\\.config)", "commands": [["bun", "run", "test:exports"]] }
    ]
  },
  "maxRepairCycles": 5,
  "maxAgentTurns": 30,
  "maxProtocolErrors": 2,
  "maxEnvironmentRetries": 2,
  "commandTimeoutMs": 900000,
  "agentTimeoutMs": 1800000,
  "notify": {
    "on": [
      "blocked",
      "done"
    ],
    "command": "scripts/coordinator-notify.sh"
  },
  "skills": {
    "implement": ".agents/skills/implement",
    "review": ".agents/skills/code-review",
    "extra": [
      ".agents/skills/tdd"
    ]
  },
  "implementation": {
    "provider": "litellm",
    "model": "gpt-5.6-terra",
    "thinking": "high"
  },
  "review": {
    "provider": "litellm",
    "model": "gpt-5.6-sol",
    "thinking": "high"
  }
}
