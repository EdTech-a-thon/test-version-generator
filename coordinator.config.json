{
  "branch": "crepe-editor",
  "verify": [
    "bun test",
    "bun run test:e2e",
    "bun run build",
    "git diff --check"
  ],
  "maxRepairCycles": 3,
  "notify": {
    "on": [
      "blocked",
      "done"
    ],
    "command": "scripts/coordinator-notify.sh"
  },
  "skills": {
    "implement": ".agents/skills/implement",
    "review": ".agents/skills/code-review",
    "extra": [
      ".agents/skills/tdd"
    ]
  },
  "implementation": {
    "provider": "litellm",
    "model": "gpt-5.6-terra",
    "thinking": "high"
  },
  "review": {
    "provider": "litellm",
    "model": "gpt-5.6-sol",
    "thinking": "high"
  }
}
