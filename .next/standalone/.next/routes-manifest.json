{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/api/banks/[id]/questions",
      "regex": "^/api/banks/([^/]+?)/questions(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/banks/(?<nxtPid>[^/]+?)/questions(?:/)?$"
    },
    {
      "page": "/api/ingest/candidates/[id]",
      "regex": "^/api/ingest/candidates/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/ingest/candidates/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/ingest/[jobId]",
      "regex": "^/api/ingest/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPjobId": "nxtPjobId"
      },
      "namedRegex": "^/api/ingest/(?<nxtPjobId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/media/[key]",
      "regex": "^/api/media/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkey": "nxtPkey"
      },
      "namedRegex": "^/api/media/(?<nxtPkey>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/tests/[id]/forms/[formId]/export",
      "regex": "^/api/tests/([^/]+?)/forms/([^/]+?)/export(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPformId": "nxtPformId"
      },
      "namedRegex": "^/api/tests/(?<nxtPid>[^/]+?)/forms/(?<nxtPformId>[^/]+?)/export(?:/)?$"
    },
    {
      "page": "/banks/[id]",
      "regex": "^/banks/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/banks/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tests/[id]",
      "regex": "^/tests/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/tests/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tests/[id]/forms/[formId]",
      "regex": "^/tests/([^/]+?)/forms/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPformId": "nxtPformId"
      },
      "namedRegex": "^/tests/(?<nxtPid>[^/]+?)/forms/(?<nxtPformId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/banks",
      "regex": "^/banks(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/banks(?:/)?$"
    },
    {
      "page": "/ingest",
      "regex": "^/ingest(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ingest(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/questions/new",
      "regex": "^/questions/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/questions/new(?:/)?$"
    },
    {
      "page": "/register",
      "regex": "^/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register(?:/)?$"
    },
    {
      "page": "/tests/new",
      "regex": "^/tests/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tests/new(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}