{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testparrot.com/formats/exam/0.2.0/schema.json",
  "title": "Test Parrot Exam Record 0.2.0",
  "description": "The composition of one Exam: its name, its own test-page header, how its section headings read and how large they print, and its ordered positions, each referencing a Question in a Question Bank Record travelling in the same Test Parrot Package.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "name",
    "positions"
  ],
  "properties": {
    "format": {
      "const": "test-parrot/exam"
    },
    "formatVersion": {
      "const": "0.2.0"
    },
    "name": {
      "type": "string"
    },
    "sectionHeadings": {
      "description": "The Exam's own wording for its Question Section headings, keyed by Question Type. Only departures from Test Parrot's default wording are recorded; an empty string is a part the teacher cleared, which prints nothing.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "multiple-choice",
          "true-false",
          "matching",
          "short-answer",
          "multipart"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/sectionHeading"
      }
    },
    "headingSize": {
      "description": "How large every section heading and its directions print. Absent means normal.",
      "enum": [
        "small",
        "normal",
        "large"
      ]
    },
    "header": {
      "description": "The Exam's own test-page header, in place of Test Parrot's default. `later` prints on every test page, and on the first as well unless `differentFirstPage` gives it `first`. An `exam-id` node prints the paper's ID. Absent means the default header.",
      "type": "object",
      "required": [
        "differentFirstPage",
        "first",
        "later"
      ],
      "additionalProperties": false,
      "properties": {
        "differentFirstPage": {
          "type": "boolean"
        },
        "first": {
          "$ref": "#/$defs/document"
        },
        "later": {
          "$ref": "#/$defs/document"
        }
      }
    },
    "media": {
      "description": "The images the header shows, referenced from it by `asset`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaAsset"
      }
    },
    "positions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "object",
          "required": [
            "bank",
            "question"
          ],
          "properties": {
            "bank": {
              "type": "string",
              "minLength": 1
            },
            "question": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "columns": {
          "enum": [
            1,
            2,
            4
          ]
        },
        "answerOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workSpace": {
          "$ref": "#/$defs/workSpace"
        }
      }
    },
    "workSpace": {
      "type": "object",
      "required": [
        "height",
        "style",
        "fill"
      ],
      "properties": {
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "style": {
          "enum": [
            "blank",
            "lines"
          ]
        },
        "fill": {
          "type": "boolean"
        }
      }
    },
    "sectionHeading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "instructions": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "heading",
            "blockquote",
            "bullet-list",
            "ordered-list",
            "list-item",
            "code-block",
            "rule",
            "table",
            "table-row",
            "table-cell",
            "inline-math",
            "display-math",
            "hard-break",
            "text",
            "inline-image",
            "block-image",
            "exam-id"
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "text": {
          "type": "string"
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "header": {
          "type": "boolean"
        },
        "asset": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "authoredSize": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "borders": {
          "description": "On a header table: whether it prints with borders. Absent means it prints without.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "inline-image",
                  "block-image"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "asset": {
                "type": "string"
              }
            },
            "required": [
              "asset"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "inline-math",
                  "display-math"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "source": {
                "type": "string"
              }
            },
            "required": [
              "source"
            ]
          }
        }
      ]
    },
    "mark": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "strong",
            "emphasis",
            "inline-code",
            "strike",
            "subscript",
            "superscript",
            "link"
          ]
        },
        "href": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "href": {
                "type": "string"
              }
            },
            "required": [
              "href"
            ]
          }
        }
      ]
    },
    "document": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "const": "document"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "mediaAsset": {
      "type": "object",
      "required": [
        "id",
        "mimeType",
        "width",
        "height",
        "bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "mimeType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "string"
        }
      }
    }
  }
}
