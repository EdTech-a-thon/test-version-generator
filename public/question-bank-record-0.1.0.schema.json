{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testparrot.com/formats/question-bank/0.1.0/schema.json",
  "title": "Test Parrot Question Bank Record",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "generator",
    "requiredFeatures",
    "integrity",
    "bank",
    "media"
  ],
  "properties": {
    "format": { "const": "test-parrot/question-bank" },
    "formatVersion": { "const": "0.1.0" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "requiredFeatures": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha-256" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "bank": {
      "type": "object",
      "required": ["name", "questions"],
      "properties": {
        "name": { "type": "string" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "media": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "document" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "mark": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "strong",
            "emphasis",
            "inline-code",
            "strike",
            "subscript",
            "superscript",
            "link"
          ]
        },
        "href": { "type": "string", "pattern": "^https?://" },
        "title": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "heading",
            "blockquote",
            "bullet-list",
            "ordered-list",
            "list-item",
            "code-block",
            "rule",
            "table",
            "table-row",
            "table-cell",
            "inline-math",
            "display-math",
            "hard-break",
            "text"
          ]
        },
        "content": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "text": { "type": "string" },
        "marks": { "type": "array", "items": { "$ref": "#/$defs/mark" } },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "start": { "type": "integer" },
        "language": { "type": "string" },
        "source": { "type": "string" },
        "header": { "type": "boolean" }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "type", "stem"],
      "properties": {
        "id": { "type": "string", "pattern": "^q[1-9][0-9]*$" },
        "type": { "enum": ["multiple-choice", "short-answer"] },
        "stem": { "$ref": "#/$defs/document" },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "topics": { "type": "array", "items": { "type": "string" } },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "content", "correct"],
            "properties": {
              "id": { "type": "string" },
              "content": { "$ref": "#/$defs/document" },
              "correct": { "type": "boolean" }
            }
          }
        },
        "suggestedAnswer": { "$ref": "#/$defs/document" }
      }
    }
  }
}
