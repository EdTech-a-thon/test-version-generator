{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testparrot.com/formats/exam/0.2.0/schema.json",
  "title": "Test Parrot Exam Record 0.2.0",
  "description": "The composition of one Exam: its name, its test-page header lines, how its section headings read, and how large its headings and text print, and its ordered positions, each referencing a Question in a Question Bank Record travelling in the same Test Parrot Package.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "name",
    "positions"
  ],
  "properties": {
    "format": {
      "const": "test-parrot/exam"
    },
    "formatVersion": {
      "const": "0.2.0"
    },
    "name": {
      "type": "string"
    },
    "sectionHeadings": {
      "description": "The Exam's own wording for its Question Section headings, keyed by Question Type. Only departures from Test Parrot's default wording are recorded; an empty string is a part the teacher cleared, which prints nothing.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "multiple-choice",
          "true-false",
          "matching",
          "short-answer",
          "multipart"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/sectionHeading"
      }
    },
    "headingSize": {
      "description": "How large every heading on the Exam prints: its title, and each section heading and its directions. Absent means normal.",
      "enum": [
        "small",
        "normal",
        "large"
      ]
    },
    "textSize": {
      "description": "How large the Exam's questions, answers and answer-key lines print. Absent means normal.",
      "enum": [
        "small",
        "normal",
        "large"
      ]
    },
    "header": {
      "description": "The Exam's own wording for its test-page header lines, where it departs from Test Parrot's default blanks. `first` prints on the first test page and `later` on every other; underscores are the blanks. An empty string prints nothing but the paper's ID, which is never part of the line. Absent means the default.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first": {
          "type": "string"
        },
        "later": {
          "type": "string"
        }
      }
    },
    "positions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "object",
          "required": [
            "bank",
            "question"
          ],
          "properties": {
            "bank": {
              "type": "string",
              "minLength": 1
            },
            "question": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "columns": {
          "enum": [
            1,
            2,
            4
          ]
        },
        "answerOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workSpace": {
          "$ref": "#/$defs/workSpace"
        }
      }
    },
    "workSpace": {
      "type": "object",
      "required": [
        "height",
        "style",
        "fill"
      ],
      "properties": {
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "style": {
          "enum": [
            "blank",
            "lines"
          ]
        },
        "fill": {
          "type": "boolean"
        }
      }
    },
    "sectionHeading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "instructions": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
